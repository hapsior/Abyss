; Otchłań 2.0 – Godot 4.7 (.NET / C#)
config_version=5

[application]

config/name="Otchłań"
config/description="Roguelike w stylu Brotato / The Binding of Isaac"
config/version="2.0.0-dev"
run/main_scene="res://scenes/Boot.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="Otchlan"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
boot_splash/bg_color=Color(0.07, 0.05, 0.1, 1)
boot_splash/show_image=false
run/max_fps=0

[autoload]

Game="*res://src/Core/Game.cs"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[dotnet]

project/assembly_name="Otchlan"

[gui]

common/drop_mouse_on_gui_input_disabled=true

[importer_defaults]

texture={
"mipmaps/generate": true
}

[input_devices]

pointing/emulate_touch_from_mouse=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=3
environment/defaults/default_clear_color=Color(0.07, 0.05, 0.1, 1)
